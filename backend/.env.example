# Browser-visible URL used by the Vite client. Leave empty to use the current origin.
VITE_SERVER_URL=

# Server bind configuration. Do not put secrets in this file.
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Optional production web build directory. When set, Fastify serves the Vite build and Socket.IO from one port.
WEB_ROOT=
